# Firebase Web App config
# Pegue em: console.firebase.google.com → Project Settings → General → "Your apps" → Web app

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Opcional: App Check (recaptcha v3)
# Pegue em: console.firebase.google.com → App Check → reCAPTCHA v3 → site key
VITE_RECAPTCHA_SITE_KEY=

# Opcional: Google Drive (kit de documentos da admissão).
# Client ID OAuth do tipo "Aplicativo da Web" (escopo drive.file). NÃO é
# segredo — fica versionado um fallback em src/core/google/driveConfig.ts.
# Só preencha aqui se quiser usar OUTRO projeto Google (ex: staging).
VITE_GOOGLE_CLIENT_ID=
# API Key da Google Picker API (seletor de pasta). Chave de navegador restrita
# à Picker API — fallback versionado em driveConfig.ts. Sobrescreva se quiser.
VITE_GOOGLE_PICKER_API_KEY=

# ── Clicksign (assinatura de documentos — API v3 Envelope) ──
# SERVER-SIDE (Vercel → Environment Variables), NÃO prefixe com VITE_ (é segredo):
#   CLICKSIGN_ACCESS_TOKEN          = token de produção (app.clicksign.com)
#   CLICKSIGN_ACCESS_TOKEN_SANDBOX  = token de sandbox (sandbox.clicksign.com) — testes
# Gere em: Clicksign → Configurações → API → "Gerar Access Token".
#
# CLIENTE (build do front) — opcional, só pra testar no sandbox:
VITE_CLICKSIGN_SANDBOX=
