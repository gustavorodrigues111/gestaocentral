rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Cardápios públicos: leitura aberta (site público abre PDF sem auth)
    // + write autenticado (admin sobe PDF, ícones e arte de capa/miolo).
    match /cardapios/{rid}/{file=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 20 * 1024 * 1024  // máx 20 MB
        && (
          request.resource.contentType.matches("application/pdf")
          || request.resource.contentType.matches("image/.*")
        );
    }

    // Cardápios anexados a Pacotes de Evento: cliente recebe o link via
    // WhatsApp depois de virar lead, então leitura é aberta. Write só com auth.
    // Path: pacotes-cardapios/{rid}/{pacoteId}/{id}.pdf
    match /pacotes-cardapios/{rid}/{pacoteId}/{file=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches("application/pdf");
    }

    // Comprovantes de pagamento de Vendas: só autenticado lê e escreve.
    // Path: vendas-comprovantes/{rid}/{vendaId}/{id}.{ext}
    match /vendas-comprovantes/{rid}/{vendaId}/{file=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 20 * 1024 * 1024
        && (
          request.resource.contentType.matches("application/pdf")
          || request.resource.contentType.matches("image/.*")
        );
    }

    // Logos / imagens dos sites: leitura aberta + write autenticado.
    match /sites/{rid}/{file=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024   // máx 5 MB
        && request.resource.contentType.matches("image/.*");
    }

    // Currículos de candidaturas "Trabalhe Conosco": cliente faz upload
    // sem auth, mas só lê com auth.
    match /candidaturas/{rid}/{file=**} {
      allow read: if request.auth != null;
      allow create: if request.resource.size < 10 * 1024 * 1024
        && (
          request.resource.contentType.matches("application/pdf")
          || request.resource.contentType.matches("image/.*")
        );
      allow update, delete: if request.auth != null;
    }

    // Faturas de cartão (PDF): privadas — só usuário autenticado lê/escreve.
    // Path: faturas-cartao/{rid}/{file}
    match /faturas-cartao/{rid}/{file=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches("application/pdf");
    }

    // Documentos de admissão: o candidato sobe RG/CPF/etc pelo form público
    // (sem auth, via token na URL), o DP lê/baixa com auth pra conferir e subir
    // pro Drive. Path: admissoes/{rid}/{admissaoId}/{docId}/{file}
    match /admissoes/{rid}/{admissaoId}/{file=**} {
      allow read: if request.auth != null;
      allow create: if request.resource.size < 10 * 1024 * 1024  // máx 10 MB
        && (
          request.resource.contentType.matches("application/pdf")
          || request.resource.contentType.matches("image/jpeg")
          || request.resource.contentType.matches("image/png")
        );
      allow update, delete: if request.auth != null;
    }

    // Checklists: foto-guia (template) e foto-prova (execução). Só com auth.
    // Path: checklists/{rid}/{file=**}
    match /checklists/{rid}/{file=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 25 * 1024 * 1024  // máx 25 MB
        && (
          request.resource.contentType.matches("image/.*")
          || request.resource.contentType.matches("application/pdf")
        );
    }

    // Catch-all: nega o que não tá listado
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
