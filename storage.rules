rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Cardápios públicos: leitura aberta (site público abre PDF sem auth)
    // + write autenticado (admin sobe PDF, ícones e arte de capa/miolo).
    match /cardapios/{rid}/{file=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 20 * 1024 * 1024  // máx 20 MB
        && (
          request.resource.contentType.matches("application/pdf")
          || request.resource.contentType.matches("image/.*")
        );
    }

    // Cardápios anexados a Pacotes de Evento: cliente recebe o link via
    // WhatsApp depois de virar lead, então leitura é aberta. Write só com auth.
    // Path: pacotes-cardapios/{rid}/{pacoteId}/{id}.pdf
    match /pacotes-cardapios/{rid}/{pacoteId}/{file=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches("application/pdf");
    }

    // Cardápios anexados ao BEO (ordem do evento pra cozinha): leitura aberta
    // (link compartilhável) + write autenticado. Path: beos-cardapios/{rid}/{leadId}/{id}.pdf
    match /beos-cardapios/{rid}/{leadId}/{file=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches("application/pdf");
    }

    // Comprovantes de pagamento de Vendas: só autenticado lê e escreve.
    // Path: vendas-comprovantes/{rid}/{vendaId}/{id}.{ext}
    match /vendas-comprovantes/{rid}/{vendaId}/{file=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 20 * 1024 * 1024
        && (
          request.resource.contentType.matches("application/pdf")
          || request.resource.contentType.matches("image/.*")
        );
    }

    // Logos / imagens dos sites: leitura aberta + write autenticado.
    match /sites/{rid}/{file=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024   // máx 5 MB
        && request.resource.contentType.matches("image/.*");
    }

    // Fotos dos processos (Wiki de Processos)
    match /wiki/{rid}/{file=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 8 * 1024 * 1024   // máx 8 MB
        && request.resource.contentType.matches("image/.*");
    }

    // Currículos de candidaturas "Trabalhe Conosco": cliente faz upload
    // sem auth, mas só lê com auth.
    match /candidaturas/{rid}/{file=**} {
      allow read: if request.auth != null;
      // Candidato anônimo: aceita PDF, Word (.doc/.docx), ODT e imagens. O
      // octet-stream é fallback pra navegadores (iOS) que não detectam o tipo.
      allow create: if request.resource.size < 10 * 1024 * 1024
        && (
          request.resource.contentType.matches("application/pdf")
          || request.resource.contentType.matches("image/.*")
          || request.resource.contentType.matches("application/msword")
          || request.resource.contentType.matches("application/vnd.openxmlformats-officedocument.wordprocessingml.document")
          || request.resource.contentType.matches("application/vnd.oasis.opendocument.text")
          || request.resource.contentType.matches("application/octet-stream")
        );
      allow update, delete: if request.auth != null;
    }

    // Espelhos de folha de pagamento (PDF): privados — só autenticado.
    // Path: folhas/{rid}/{competencia}/{file}
    match /folhas/{rid}/{file=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 30 * 1024 * 1024
        && request.resource.contentType.matches("application/pdf");
    }

    // Faturas de cartão (PDF): privadas — só usuário autenticado lê/escreve.
    // Path: faturas-cartao/{rid}/{file}
    match /faturas-cartao/{rid}/{file=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches("application/pdf");
    }

    // Documentos de admissão: o candidato sobe RG/CPF/etc pelo form público
    // (sem auth, via token na URL), o DP lê/baixa com auth pra conferir e subir
    // pro Drive. Path: admissoes/{rid}/{admissaoId}/{docId}/{file}
    match /admissoes/{rid}/{admissaoId}/{file=**} {
      allow read: if request.auth != null;
      allow create: if request.resource.size < 10 * 1024 * 1024  // máx 10 MB
        && (
          request.resource.contentType.matches("application/pdf")
          || request.resource.contentType.matches("image/jpeg")
          || request.resource.contentType.matches("image/png")
        );
      allow update, delete: if request.auth != null;
    }

    // Checklists: foto-guia (template) e foto-prova (execução). Só com auth.
    // Path: checklists/{rid}/{file=**}
    match /checklists/{rid}/{file=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 25 * 1024 * 1024  // máx 25 MB
        && (
          request.resource.contentType.matches("image/.*")
          || request.resource.contentType.matches("application/pdf")
        );
    }

    // Segurança Sanitária: fotos das não-conformidades. Só com auth.
    // Path: seguranca/{rid}/{file=**}
    match /seguranca/{rid}/{file=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 25 * 1024 * 1024  // máx 25 MB
        && request.resource.contentType.matches("image/.*");
    }

    // WhatsApp: mídia recebida (imagem/áudio/vídeo/documento) subida pelo webhook
    // como usuário de serviço. Leitura pela URL tokenizada (bypassa rules).
    // Path: whatsapp/{numeroId}/{file=**}
    match /whatsapp/{numeroId}/{file=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 30 * 1024 * 1024;
    }

    // Catch-all: nega o que não tá listado
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
