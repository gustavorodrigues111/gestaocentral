rules_version = '2';
// ════════════════════════════════════════════════════════════════════════════
//  FIRESTORE RULES — Planejamento (gestaocentral-85b13) — Phase 1
//
//  Objetivos desta versão:
//   1. Bloquear escalada de privilégio (ninguém vira master, ninguém altera
//      permissões alheias).
//   2. Bloquear alteração estrutural por não-admin (criar restaurante, cargo,
//      pessoa).
//   3. Manter leitura ampla (auth-only) — Phase 2 vai escopar por restaurantId.
//   4. Negar coleções desconhecidas (whitelist).
//
//  Master:
//    Email registrado em /admins/{email}. Hoje: gustavo@quibebe.com.br.
//    Pra promover outro: criar /admins/<email-do-novo-master> no Console.
//    Pra revogar: deletar o doc.
// ════════════════════════════════════════════════════════════════════════════
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────────────────
    function authed()  { return request.auth != null; }
    function isMaster() {
      return authed()
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }
    // Lista de campos GENUINAMENTE sensíveis (escalada de privilégio).
    // Inativar/reativar, vincular novo restaurante, etc. são ops administrativas
    // NORMAIS que qualquer admin do app pode fazer — não exigem master.
    function pessoaSensitiveChanged() {
      let sensitive = ['isMaster','permissions','restaurantIds','specialPermissions'];
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(sensitive);
    }

    // ── /admins ── lista de masters por email ────────────────────────────
    match /admins/{email} {
      allow read:  if authed();
      allow write: if isMaster();
    }

    // ── /falhasLog ── Monitor de falhas. Gravado pelo usuário de serviço
    //   (/api/reportar-falha, authed); só o master lê e resolve. ───────────
    match /falhasLog/{id} {
      allow read:   if isMaster();
      allow create: if authed() && request.resource.data.size() < 30;
      // Master edita/remove; o usuário de serviço (healthcheck) só pode marcar resolvido.
      allow update: if isMaster()
        || (authed() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolvidoEm']));
      allow delete: if isMaster();
    }

    // ── /monitorEstado ── estado do Monitor (ex.: saúde da Evolution). Gravado
    //   pelo cron/usuário de serviço; lido pelo app pra mostrar status. ────────
    match /monitorEstado/{id} {
      allow read, write: if authed();
    }

    // ── Conferência de folhas de pagamento (dados sensíveis: financeiro +
    //   PII de empregado). Qualquer authed lê/grava; UI gateia por permissão.
    match /folhasConferencia/{id} {
      allow read, write: if authed();
    }
    match /folhasWhitelist/{id} {
      allow read, write: if authed();
    }

    // Prazos (módulo unificado). Sensível (financeiro + PII). Authed lê/grava;
    // a UI gateia por permissão (prazos.ver / prazos.gerir).
    match /prazos/{id} {
      allow read, write: if authed();
    }
    // Imóveis (cadastro compartilhado — prédios/endereços por empresa).
    match /imoveis/{id} {
      allow read, write: if authed();
    }

    // ── /pessoas ── identidades + permissões ─────────────────────────────
    match /pessoas/{id} {
      allow read:   if authed();
      // Create: qualquer admin authed pode criar Pessoa, mas NÃO pode criar
      // como master (defesa contra escalada de privilégio). Caso de uso
      // principal: cadastro rápido de freela pelo módulo Freelas.
      allow create: if isMaster()
        || (authed() && request.resource.data.isMaster == false);
      // Update: master, OU própria pessoa SÓ mexendo em uidVinculado
      //        (necessário pro AuthContext linkar uid → pessoa no 1º login)
      allow update: if isMaster()
        || (
          resource.data.email == request.auth.token.email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uidVinculado'])
        )
        // OU é alteração não-sensível feita por qualquer authed
        // (deixa admin no app editar nome/email/whatsapp/cpf de pessoas existentes
        // sem precisar ser master — Phase 2 vai apertar mais)
        || (authed() && !pessoaSensitiveChanged());
      allow delete: if isMaster();
    }

    // ── /restaurants ── estrutura organizacional, só master mexe ─────────
    match /restaurants/{rid} {
      allow read:   if authed();
      allow create, update, delete: if isMaster();
    }

    // ── /cargos ── definidos pelo admin do restaurante (Phase 1: master) ──
    match /cargos/{id} {
      allow read:   if authed();
      allow create, update, delete: if isMaster();
    }

    // ── /permissionTemplates ── DESCONTINUADO (Rodada 5) ────────────────
    // Sistema antigo de templates de ver/configurar. Substituído por
    // /accessProfiles. Read autenticado mantido pra docs históricos não
    // dispararem permission-denied em queries residuais. Write travado.
    match /permissionTemplates/{id} {
      allow read:   if authed();
      allow create, update, delete: if false;
    }

    // ── /accessProfiles ── sistema novo de perfis de acesso ─────────────
    // Todos authed leem (precisam pra resolver canAcao). Só master cria/edita.
    // Built-ins vivem no código (src/core/auth/builtinProfiles.ts) — Firestore
    // armazena custom + overrides de built-ins (mesmo id).
    match /accessProfiles/{id} {
      allow read:   if authed();
      allow create, update, delete: if isMaster();
    }

    // ── /auditLog ── append-only ────────────────────────────────────────
    match /auditLog/{id} {
      allow read:   if authed();
      allow create: if authed();
      allow update, delete: if false;
    }

    // ── /historicos ── histórico versionado de campos (versionedChange grava aqui)
    match /historicos/{id} {
      allow read:   if authed();
      allow create, update: if authed();
      allow delete: if isMaster();
    }

    // ── /mudancasAgendadas ── mudanças futuras agendadas ────────────────
    match /mudancasAgendadas/{id} {
      allow read:   if authed();
      allow create, update, delete: if authed();
    }

    // ── /splitVersions ── regras de divisão de gorjeta (versionadas) ───
    match /splitVersions/{id} {
      allow read:   if authed();
      allow create, update: if authed();
      allow delete: if isMaster();
    }

    // ── Operacional / dia-a-dia (Phase 2: escopar por restaurantId) ──────
    match /empregados/{id}          { allow read, write: if authed(); }
    match /escalas/{id}             { allow read, write: if authed(); }
    match /escalaSolicitacoes/{id}  { allow read, write: if authed(); }
    match /faleDpMensagens/{id}     { allow read, write: if authed(); }
    match /pontoRascunhos/{id}      { allow read, write: if authed(); }
    match /escalasNomeadas/{id}     { allow read, write: if authed(); }
    match /sundaySwaps/{id}         { allow read, write: if authed(); }
    match /cardapioEstado/{id}      { allow read, write: if authed(); }
    match /cardapioVersoes/{id}     { allow read, write: if authed(); }
    match /freelaShifts/{id}        { allow read, write: if authed(); }
    match /freelaPagamentos/{id}    { allow read, write: if authed(); }
    match /freelaMensalistaConfirmado/{id} { allow read, write: if authed(); }
    match /vendas/{id}                 { allow read, write: if authed(); }
    match /vendasProdutos/{id}         { allow read, write: if authed(); }
    match /vendasClientes/{id}         { allow read, write: if authed(); }
    match /vendasFormasPagamento/{id}  { allow read, write: if authed(); }
    match /vendasCobrancas/{id}        { allow read, write: if authed(); }
    match /ftInsumos/{id}              { allow read, write: if authed(); }
    match /ftFichas/{id}               { allow read, write: if authed(); }
    match /ftCategorias/{id}           { allow read, write: if authed(); }
    match /ftUnidades/{id}             { allow read, write: if authed(); }
    match /ftPlanosProducao/{id}       { allow read, write: if authed(); }
    match /ftConfig/{id}               { allow read, write: if authed(); }
    match /acoes/{id}                  { allow read, write: if authed(); }
    match /caderno/{id}                { allow read, write: if authed(); }
    match /whatsappEnvios/{id}         { allow read, write: if authed(); }
    match /whatsappMensagens/{id}      { allow read, write: if authed(); }
    match /whatsappStatus/{id}         { allow read, write: if authed(); }
    match /whatsappContatos/{id}       { allow read, write: if authed(); }
    match /whatsappTags/{id}           { allow read, write: if authed(); }
    match /whatsappNumeros/{id}        { allow read, write: if authed(); }
    match /whatsappRespostas/{id}      { allow read, write: if authed(); }
    match /whatsappRoteios/{id}        { allow read, write: if authed(); }
    match /whatsappAgenteSessoes/{id}  { allow read, write: if authed(); }
    match /rotinaNotificacoes/{id}     { allow read, write: if authed(); }
    match /notificacaoConfigs/{id}     { allow read, write: if authed(); }
    match /enderecos/{id}              { allow read, write: if authed(); }
    match /cartaoCategorias/{id}       { allow read, write: if authed(); }
    match /cartaoFaturas/{id}          { allow read, write: if authed(); }
    match /cartaoLancamentos/{id}      { allow read, write: if authed(); }
    // Agentes de IA: config só master edita; conversas authed; logs append-only.
    match /agentesIA/{id}     { allow read: if authed(); allow create, update, delete: if isMaster(); }
    match /agenteMensagens/{id} { allow read, write: if authed(); }
    match /agenteLogs/{id}    { allow read: if authed(); allow create: if authed(); allow update, delete: if false; }
    match /ftCardapio/{id}             { allow read, write: if authed(); }
    match /ftImportRascunhos/{id}      { allow read, write: if authed(); }
    match /ftVinculosRecebimento/{id}  { allow read, write: if authed(); }
    match /excecoesStatusSemana/{id} { allow read, write: if authed(); }
    match /excecoesDiaStatus/{id}    { allow read, write: if authed(); }
    match /excecoesApontamentoStatus/{id} { allow read, write: if authed(); }
    match /excecoesLoteRascunho/{id} { allow read, write: if authed(); }
    match /comparacoesCadastros/{id} { allow read, write: if authed(); }
    match /gorjetas/{id}            { allow read, write: if authed(); }
    match /vtFolhas/{id}            { allow read, write: if authed(); }
    match /vtLotes/{id}             { allow read, write: if authed(); }
    match /vrLotes/{id}             { allow read, write: if authed(); }
    match /beneficiosLotes/{id}     { allow read, write: if authed(); }
    match /beneficioPagamentos/{id} { allow read, write: if authed(); }
    match /beneficioAjustes/{id}    { allow read, write: if authed(); }
    match /recebimentos/{id}        { allow read, write: if authed(); }
    match /fechamentosCaixa/{id}    { allow read, write: if authed(); }
    match /conciliacoesCaixa/{id}   { allow read, write: if authed(); }
    match /comunicados/{id}         { allow read, write: if authed(); }
    match /comunicadoLeituras/{id}  { allow read, write: if authed(); }
    match /ocorrencias/{id}         { allow read, write: if authed(); }
    // Banco de Ideias: privada só o dono lê/edita (o master vê todas). Pública
    // (ou legado sem o campo) = qualquer autenticado. Enforce real da privacidade.
    match /ideias/{id} {
      allow read:          if authed() && (resource.data.visibilidade != 'privada' || resource.data.criadoPor == request.auth.uid || isMaster());
      allow create:        if authed();
      allow update, delete: if authed() && (resource.data.visibilidade != 'privada' || resource.data.criadoPor == request.auth.uid || isMaster());
    }
    match /reunioes/{id}            { allow read, write: if authed(); }
    // Trilha do Empregado — dados ULTRA sensíveis (LGPD + trabalhista).
    // Por padrão só master pode ver/escrever. Pra liberar outras pessoas:
    // adicionar email em /admins (vira master) OU evoluir rules futuras
    // pra checar perfil de acesso server-side.
    // Não usar hard delete — UI usa anulação (campo `anulado: true`).
    // Visualizações são logadas em /trilhaVisualizacaoLog (LGPD).
    match /eventosTrilha/{id} {
      allow read:   if isMaster();
      allow create: if isMaster();
      allow update: if isMaster();
      allow delete: if false;
    }
    match /trilhaVisualizacaoLog/{id} {
      allow read:   if isMaster();
      allow create: if authed();                // qualquer um que abre a trilha registra
      allow update, delete: if false;
    }
    // ── Gestor de Tarefas — confidencialidade real (Fase 5) ──────────────
    //
    // tarefas: read CONDICIONAL — só vê quem é master, criador, responsável,
    // co-responsável, está na lista usuariosAutorizados, OU a visibilidade
    // efetiva é "publico"/"escritorio". Grupos (grupo_dp, etc.) ainda passam
    // com auth-only nesta fase — fase 6 vai amarrar ao accessProfile.
    //
    // tarefaProjetos / tarefaSubprojetos: read auth-only por enquanto (lista
    // de projetos não é considerada sensível; o que importa são as tarefas).
    //
    // Write: auth-only com UI validando. Delete só master (soft delete via
    // app).
    function tarefaPodeLer() {
      let d = resource.data;
      return isMaster()
        || request.auth.uid == d.criadoPor
        || request.auth.uid == d.responsavelId
        || (d.coResponsaveis is list && request.auth.uid in d.coResponsaveis)
        || (d.observadoresIds is list && request.auth.uid in d.observadoresIds)
        || (d.subtarefaResponsaveisIds is list && request.auth.uid in d.subtarefaResponsaveisIds)
        || (d.usuariosAutorizados is list && request.auth.uid in d.usuariosAutorizados)
        || d.visibilidadeEfetiva == "publico"
        || d.visibilidadeEfetiva == "escritorio";
      // Docs antigos sem visibilidadeEfetiva ou com "grupo_*" legado:
      // tratados como privados — só passam pelas condições acima.
    }
    match /tarefaProjetos/{id}      { allow read, write: if authed(); allow delete: if isMaster(); }
    match /tarefaSubprojetos/{id}   { allow read, write: if authed(); allow delete: if isMaster(); }
    match /tarefas/{id} {
      allow read: if authed() && tarefaPodeLer();
      allow create: if authed();
      allow update: if authed() && tarefaPodeLer();
      allow delete: if isMaster();
    }
    // ── Cadastros mestres (geram tarefas) ────────────────────────────────
    match /contasFixas/{id}         { allow read, write: if authed(); allow delete: if isMaster(); }
    match /manutencoes/{id}         { allow read, write: if authed(); allow delete: if isMaster(); }
    match /agendaTrabResolvidos/{id} { allow read, write, delete: if authed(); }
    match /wikiProcessos/{id}       { allow read, write: if authed(); allow delete: if isMaster(); }
    match /wikiConfig/{rid}         { allow read, write: if authed(); }
    match /iaConfig/{rid}           { allow read, write: if authed(); }
    match /iaInteracoes/{id}        { allow read, create: if authed(); allow update, delete: if isMaster(); }
    // Exames médicos (Fase 7) — auth-only por enquanto. Fase futura: escopo
    // por rest + perfis com canAcao("exames", "ver"). Dados sensíveis (LGPD).
    match /exameTiposConfig/{id}    { allow read, write: if authed(); allow delete: if isMaster(); }
    match /examesEmpregado/{id}     { allow read, write: if authed(); allow delete: if isMaster(); }
    // Processos de Demissão (Fase 8) — auth-only por enquanto. Sensível.
    match /processosDemissao/{id}   { allow read, write: if authed(); allow delete: if isMaster(); }
    // Ferramentas e Credenciais — catálogo de acessos a sistemas externos.
    // App NÃO guarda senha (só metadado + link Bitwarden). Leitura auth-only;
    // filtragem por usuariosAutorizados é client-side. Escrita = qualquer auth
    // (refinar pra master/canAcao em fase futura). Delete só master.
    match /tools/{id}               { allow read, write: if authed(); allow delete: if isMaster(); }
    // Reservas: doc PRINCIPAL contém só metadados sem PII (data, horario,
    // pessoas, salaoId, status, clienteId). PII (nome/telefone/email/
    // observações/ocasião) vive em /reservasPII com read auth-only.
    //
    // Read público no /reservas é seguro porque só expõe contadores
    // agregáveis (quantas pessoas reservadas pra um slot). Form público
    // usa isso pra calcular disponibilidade sem ver dados pessoais.
    match /reservas/{id} {
      allow read: if true;
      allow create: if authed()
        || (
          request.resource.data.status == "pendente"
          && request.resource.data.origem == "publico"
        );
      allow update, delete: if authed();
    }
    // ReservasPII — dados pessoais sensíveis. Read SÓ authed (admin).
    // Public form pode CRIAR (escrever), mas nunca LER.
    match /reservasPII/{id} {
      allow read: if authed();
      allow create: if authed()
        || (
          // Public create: validar shape mínima de PII pra evitar abuso
          request.resource.data.restaurantId is string
          && request.resource.data.clienteNomeSnapshot is string
        );
      allow update, delete: if authed();
    }
    // Solicitações de exclusão de dados (LGPD Art. 18). Cliente envia pelo
    // form público /r/excluir-dados/:rid. Create público com guards (status
    // sempre pendente). Read/process só authed.
    match /solicitacoesExclusao/{id} {
      allow read: if authed();
      allow create: if authed()
        || (
          request.resource.data.status == "pendente"
          && request.resource.data.restaurantId is string
          && request.resource.data.telefone is string
        );
      allow update, delete: if authed();
    }
    // Salões: read público (form precisa listar salões disponíveis com
    // capacidade pra calcular vagas). Write só authed.
    match /saloes/{id} {
      allow read: if true;
      allow create, update, delete: if authed();
    }
    // Clientes do CRM: read authed (admin). Create público permitido com
    // guards — o form de reservas cria o cliente junto com a reserva.
    // Update público restrito a nome/email/telefone/atualizadoEm — usado
    // quando cliente reconhecido pelo lookup altera seus dados ao fazer
    // nova reserva. Campos sensíveis (aniversário, restrições, tags,
    // stats) só admin mexe.
    match /clientes/{id} {
      allow read: if authed();
      allow create: if authed()
        || (
          request.resource.data.restaurantId is string
          && request.resource.data.nome is string
          && request.resource.data.nome.size() > 0
          && request.resource.data.telefone is string
          && request.resource.data.telefone.size() > 0
        );
      allow update: if authed()
        || (
          // Public update: só altera nome/email/telefone/atualizadoEm.
          // Não pode mudar restaurantId, criadoEm, ou campos do CRM
          // (aniversario, tags, totalReservas, etc).
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['nome', 'email', 'telefone', 'atualizadoEm'])
        );
      allow delete: if authed();
    }
    // ── /mail ── DESCONTINUADO ─────────────────────────────────────────
    // Era a fila da Firebase Extension "Trigger Email" — abandonada porque
    // org policy do Workspace bloqueia o build da Cloud Function. Migrado
    // pra Resend via Vercel route /api/send-email (ver api/send-email.ts).
    // Mantém leitura authed pros docs antigos que ficaram no histórico;
    // create público bloqueado pra não acumular lixo (não tem worker lendo).
    match /mail/{id} {
      allow read: if authed();
      allow create, update, delete: if authed();
    }

// ── /notasCliente ── log cronológico de anotações sobre clientes ───
    // Criadas pelo admin (chegada do cliente, observação no CRM, etc).
    // Também aceita create público (form de reservas) com guards estritos
    // — usado pra logar quando cliente altera nome/email ao reservar.
    match /notasCliente/{id} {
      allow read: if authed();
      allow create: if authed()
        || (
          // Public create: shape mínimo + criadoPor="publico" (não pode
          // fingir ser admin). Sem possibilidade de logar coisa qualquer.
          request.resource.data.restaurantId is string
          && request.resource.data.clienteId is string
          && request.resource.data.texto is string
          && request.resource.data.texto.size() > 0
          && request.resource.data.texto.size() < 500
          && request.resource.data.criadoPor == "publico"
        );
      allow update, delete: if authed();
    }
    // ── /clientesPublicLookup ── reconhecimento de cliente recorrente no
    // form público de reservas, SEM expor /clientes (que tem aniversário,
    // restrições alimentares, observações, tags).
    //
    // Doc ID determinístico: <rid>_<telefoneE164 sem "+">. O form público
    // faz getDoc por ID — não consegue queryar a coleção (list bloqueado),
    // então só lê quem JÁ SABE o número exato. Mesmo nível de exposição
    // que a pessoa enviar "será que esse número é cliente do X?" ao
    // restaurante por WhatsApp.
    //
    // Campos: { restaurantId, telefoneE164, nome, email?, clienteId,
    //          atualizadoEm }. Nada mais — nem aniversário, nem obs.
    match /clientesPublicLookup/{id} {
      allow get: if true;
      allow list: if authed();
      allow create, update: if authed()
        || (
          request.resource.data.restaurantId is string
          && request.resource.data.telefoneE164 is string
          && request.resource.data.nome is string
          && request.resource.data.nome.size() > 0
          && request.resource.data.clienteId is string
        );
      allow delete: if authed();
    }
    // ConfiguracaoReservas: doc por restaurante com janelas + slots.
    // Read público (form precisa pra gerar os horários selecionáveis).
    match /configReservas/{id} {
      allow read: if true;
      allow create, update, delete: if authed();
    }
    // Config do assistente de IA no WhatsApp (diretrizes + conhecimento por
    // restaurante). Sem PII; só o app autenticado lê/escreve. O webhook lê via
    // REST com service account (fora das rules).
    match /assistenteWhatsapp/{id} {
      allow read, write: if authed();
    }
    // ExcecaoReserva: overrides por data (bloqueios, personalizações, janelas
    // extras). Read público — o form de reservas precisa respeitar bloqueios
    // e mostrar janelas extras. Write só authed (admin master ou perfil com
    // configurar/Reservas).
    match /excecoesReserva/{id} {
      allow read: if true;
      allow create, update, delete: if authed();
    }
    // Uniformes & EPIs — módulo gerencial, read/write só authed.
    match /itensUniforme/{id}        { allow read, write: if authed(); }
    match /kitsAreaUniforme/{id}     { allow read, write: if authed(); }
    match /entregasUniforme/{id}     { allow read, write: if authed(); }
    match /movEstoqueUniforme/{id}   { allow read, write: if authed(); }
    match /termoUniformesConfig/{id} { allow read, write: if authed(); }
    // (clientes está definido acima com create público pra form de reservas)
    match /mesas/{id}               { allow read, write: if authed(); }
    match /checklistTemplates/{id}  { allow read, write: if authed(); }
    match /checklistRuns/{id}       { allow read, write: if authed(); }
    match /segurancaModelos/{id}    { allow read, write: if authed(); }
    match /segurancaAvaliacoes/{id} { allow read, write: if authed(); }
    match /contagens/{id}           { allow read, write: if authed(); }
    match /insumos/{id}             { allow read, write: if authed(); }
    match /fornecedores/{id}        { allow read, write: if authed(); }
    match /pedidos/{id}             { allow read, write: if authed(); }

    // ── /admissoes ── candidato preenche o form via link público (sem auth)
    // Read: aberto (precisa pra a página pública carregar pelo token)
    // Update: aberto SOMENTE pra:
    //   - dadosPreenchidos / preenchidoEm / status (formulario_preenchido)
    //   - updatedAt
    //   Status só pode ir pra "formulario_preenchido" se estava
    //   "formulario_enviado". Restante (criação, aprovação, cancelamento) só
    //   por authed. Iteração futura: migrar pra endpoint Vercel com admin SDK.
    // ── /resetSenhaRequests ── pedido de reset de senha (processado por Cloud
    // Function que roda com Auth admin). O cliente só cria/lê/apaga o SEU pedido
    // (isolado por uid); quem valida se é master + faz o reset é a função (que
    // escreve o resultado via Admin SDK, ignorando estas regras).
    match /resetSenhaRequests/{id} {
      allow create: if authed()
        && request.resource.data.solicitadoPorUid == request.auth.uid
        && request.resource.data.status == "pendente";
      allow read, delete: if authed() && resource.data.solicitadoPorUid == request.auth.uid;
      allow update: if false;
    }

    match /admissoes/{id} {
      allow read: if true;
      allow create, delete: if authed();
      allow update: if authed()
        || (
          // Caminho público: candidato preenchendo
          (resource.data.status == "formulario_enviado")
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["dadosPreenchidos", "preenchidoEm", "status", "validacao", "documentos", "subtarefas", "dadosBancariosItau", "updatedAt"])
          && (
            // Só pode manter status atual OU mudar pra "formulario_preenchido"
            request.resource.data.status == "formulario_enviado"
            || request.resource.data.status == "formulario_preenchido"
          )
        );
    }

    // ── /eventos ── módulo de gestão de eventos privados ────────────────
    // Espaços e Pacotes: read público (pra página de captação mostrar
    // capacidade / cardápios) + write só authed.
    match /espacosEvento/{id} {
      allow read: if true;
      allow create, update, delete: if authed();
    }
    match /pacotesEvento/{id} {
      allow read: if true;
      allow create, update, delete: if authed();
    }
    // Lead: create público (cliente registra interesse via form público),
    // mas o status inicial precisa ser "novo" e origem "publico" — não
    // pode burlar criando lead já "confirmado". Read/update/delete = authed.
    match /leadsEvento/{id} {
      allow read: if authed();
      allow create: if authed()
        || (
          request.resource.data.status == "novo"
          && request.resource.data.origem == "publico"
        );
      allow update, delete: if authed();
    }
    match /propostasEvento/{id} { allow read, write: if authed(); }
    match /beosEvento/{id}      { allow read, write: if authed(); }
    match /avisosDirecionados/{id} { allow read, write: if authed(); }
    match /logsEvento/{id}      { allow read, write: if authed(); }
    match /templatesEvento/{id} { allow read, write: if authed(); }

    // ── /sites ── módulo de sites públicos ──────────────────────────────
    // sitesConfig: read público (o site público precisa ler sem auth) +
    // write authed (UI no admin).
    match /sitesConfig/{id} {
      allow read: if true;
      allow create, update, delete: if authed();
    }
    // Cardápio estruturado (editor) — read público (site lê sem auth) + write authed.
    match /cardapioEstruturado/{id} {
      allow read: if true;
      allow create, update, delete: if authed();
    }
    // Candidaturas "Trabalhe Conosco": create público + read/update authed.
    // Guards: status inicial deve ser "nova" e origem "publico".
    // Vagas do Processo Seletivo: read público (página de vagas abertas +
    // candidatura por vaga renderiza as perguntas). Write só authed.
    match /vagas/{id} {
      allow read: if true;
      allow write: if authed();
    }
    match /candidaturasTrabalhe/{id} {
      allow read: if authed();
      allow create: if authed()
        || (
          request.resource.data.status == "nova"
          && request.resource.data.origem == "publico"
        );
      allow update, delete: if authed();
    }

    // ── Chat — comunicação unificada (interno + WhatsApp externo) ──────
    //
    // Fase 1 (atual): read/write auth-only. Filtragem por participante /
    // operador da linha / master é feita CLIENT-SIDE (helper podeVerConversa).
    // Operações via webhook do gateway são executadas pela serverless com
    // Admin SDK, bypassando estas rules — daí não precisam ser tightened
    // aqui.
    //
    // Fase futura (Chat C6): apertar com função chatPodeLer() que cheque
    // request.auth.uid contra participantes/operadoresDaLinha do doc.
    //
    // - conversations: master cria/edita/apaga; outros podem participar.
    //   Soft-delete via campo `arquivado` na UI; delete só master.
    // - chatMessages: append-only do ponto de vista do usuário. Edição
    //   marca `editadoEm`; remoção marca `removidoEm` (soft). Delete real
    //   só master.
    // - contatosExternos: master + admin podem editar; delete só master.
    //   Senha NÃO mora aqui (só metadado + opt-in).
    // - linhasWhatsapp: configuração estrutural — só master.
    match /conversations/{id} {
      allow read:   if authed();
      allow create: if authed();
      allow update: if authed();
      allow delete: if isMaster();
    }
    match /chatMessages/{id} {
      allow read:   if authed();
      allow create: if authed();
      allow update: if authed();
      allow delete: if isMaster();
    }
    match /contatosExternos/{id} {
      allow read:   if authed();
      allow create: if authed();
      allow update: if authed();
      allow delete: if isMaster();
    }
    match /linhasWhatsapp/{id} {
      allow read:   if authed();
      allow create, update, delete: if isMaster();
    }

    // ── Planner (pessoal) — preferências de agenda (cor + visibilidade) ──
    // Dado NÃO sensível; só o próprio dono lê/escreve o seu doc.
    match /plannerSettings/{uid} {
      allow read, write: if authed() && request.auth.uid == uid;
    }

    // ── Auditoria de correções de ponto (Análise de Ponto) ──────────────
    // Log append-only: cria/lê autenticado; sem update/delete pra preservar
    // a integridade do registro (dado trabalhista — quem corrigiu o quê/quando).
    match /pontoAuditoria/{id} {
      allow create: if authed();
      allow read:   if authed();
      allow update, delete: if false;
    }

    // Solicitações de correção enviadas ao empregado (relógio/prazo). Atualiza
    // status (resolvido) mas não apaga — histórico do que foi cobrado e quando.
    match /pontoSolicitacoes/{id} {
      allow create, read, update: if authed();
      allow delete: if false;
    }

    // Avaliações "ciente / sem ação". Delete permitido = reabrir o apontamento.
    match /pontoAvaliacoes/{id} {
      allow create, read, update, delete: if authed();
    }

    // ── /rotinas ── lembretes recorrentes atribuídos a pessoas ──────────
    // Read auth-only (todos precisam ler as rotinas em que são responsáveis).
    // Write auth-only (UI valida quem gerencia). Delete auth (soft não aplicável).
    match /rotinas/{id} {
      allow read, write: if authed();
    }
    // Conclusões de rotina — registro de "feito por X na data Y". Append/idempotente.
    match /rotinaConclusoes/{id} {
      allow read, write: if authed();
    }

    // ── /avisosLidos ── estado de leitura da Central de Avisos ───────────
    // Doc por pessoa (id = pessoaId): { itens: { [avisoId]: emSnapshot } }.
    // Dado NÃO sensível (só controla o que já foi visto). Read/write authed.
    match /avisosLidos/{id} {
      allow read, write: if authed();
    }

    // ── Catch-all: nega coleções não listadas (whitelist) ────────────────
    match /{coll}/{doc} {
      allow read, write: if false;
    }
  }
}
