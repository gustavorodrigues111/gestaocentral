// ════════════════════════════════════════════════════════════════════════════
//  gestaocentral — Firestore security rules
// ════════════════════════════════════════════════════════════════════════════
//
//  Modelo de permissões:
//   1. Master (`pessoa.isMaster == true`) faz qualquer coisa em qualquer rest.
//   2. Pessoa "ativa" (`pessoa.ativa != false`) com `restaurantIds[]` contendo
//      o `rid` do doc tem acesso de LEITURA aos dados desse restaurante.
//   3. ESCRITA exige `permissions[rid][moduleId].configurar == true`.
//   4. Operações sensíveis exigem `specialPermissions[rid][campo] == true`.
//
//  Decisão de design — leitura ampla por restaurante, escrita por módulo:
//
//   Permissões de MÓDULO controlam SÓ escrita. Leitura é liberada pra
//   qualquer pessoa que tenha o rid em pessoa.restaurantIds[]. Justificativa:
//
//     a) O Portal do Empregado precisa ler escalas/gorjetas/comunicados sem
//        que o empregado tenha permissões de gestor — restringir read por
//        módulo quebraria o portal.
//     b) Telas de gestão exibem nomes/dados cruzados (ex: gorjetas mostra
//        empregados; escala mostra cargos). Restringir read fino quebraria
//        UIs existentes.
//     c) Multi-tenancy entre restaurantes (rid não no restaurantIds da
//        pessoa = sem acesso) já é o gate primário de segurança.
//     d) A app é interna ao restaurante; usuários são todos da mesma "casa".
//
//  Atualização desta versão: cobre todas as coleções até Sprint 21C.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ────────────────────────────────────────────────────────────────────────
    //  Helpers
    // ────────────────────────────────────────────────────────────────────────

    function isAuthed() { return request.auth != null; }

    function temPessoa() {
      return isAuthed() &&
        exists(/databases/$(database)/documents/pessoas/$(request.auth.uid));
    }

    // Carrega o doc de pessoa do usuário logado. As chamadas get() são
    // cacheadas pelo Rules engine durante uma única avaliação.
    function pessoa() {
      return get(/databases/$(database)/documents/pessoas/$(request.auth.uid)).data;
    }

    function ativa() {
      return temPessoa() && pessoa().ativa != false;
    }

    function isMaster() {
      return temPessoa() && pessoa().isMaster == true;
    }

    // True se o usuário tem o restaurantId na lista (ou é master).
    function temAcesso(rid) {
      return isMaster() || (rid in pessoa().restaurantIds);
    }

    function podeConfigurar(rid, moduleId) {
      return isMaster() ||
        (pessoa().permissions != null &&
         pessoa().permissions[rid] != null &&
         pessoa().permissions[rid][moduleId] != null &&
         pessoa().permissions[rid][moduleId].configurar == true);
    }

    // Permissão especial (pessoasExcluir, gorjetasConfigurarRegra, escalaReabrir).
    function permEspecial(rid, p) {
      return isMaster() ||
        (pessoa().specialPermissions != null &&
         pessoa().specialPermissions[rid] != null &&
         pessoa().specialPermissions[rid][p] == true);
    }

    function ridDoResource() { return resource.data.restaurantId; }
    function ridDoNovoResource() { return request.resource.data.restaurantId; }

    // Read padrão pra docs com restaurantId — qualquer pessoa do restaurante.
    function leDoRestaurant() {
      return ativa() && temAcesso(ridDoResource());
    }

    // ────────────────────────────────────────────────────────────────────────
    //  Pessoas (multi-tenancy via restaurantIds[])
    // ────────────────────────────────────────────────────────────────────────
    //  - Read: qualquer pessoa ativa (precisa ler nomes em audit, comunicados,
    //    gorjetas históricas, etc — informação interna).
    //  - Create: master.
    //  - Update: master, ou a própria pessoa pra atualizar APENAS dados
    //    pessoais. NÃO pode mexer em permissions, isMaster, ativa,
    //    restaurantIds, specialPermissions.
    //  - Delete: master ou alguém com pessoasExcluir em algum restaurante.

    match /pessoas/{pid} {
      allow read: if ativa();

      allow create: if isMaster();

      allow update: if ativa() && (
        isMaster() ||
        (request.auth.uid == pid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           'nome', 'email', 'whatsapp', 'cpf'
         ]))
      );

      // Delete: só master. A permissão `pessoasExcluir` é checada na UI
      // (canExcluirPessoa) — mas no servidor mantemos master-only porque
      // .values().hasAny() só bate com mapas exatamente iguais (frágil
      // se specialPermissions tem outras chaves).
      // Se precisar deixar não-master apagar, use cloud functions com
      // verificação programática.
      allow delete: if isMaster();
    }

    // ────────────────────────────────────────────────────────────────────────
    //  Restaurants
    // ────────────────────────────────────────────────────────────────────────

    match /restaurants/{rid} {
      allow read: if ativa() && temAcesso(rid);
      allow create: if isMaster();
      allow update: if ativa() && (isMaster() || podeConfigurar(rid, "configuracoes"));
      allow delete: if isMaster();
    }

    // ────────────────────────────────────────────────────────────────────────
    //  PESSOAS / EMPREGADOS / CARGOS / TEMPLATES
    // ────────────────────────────────────────────────────────────────────────

    match /cargos/{id} {
      allow read: if leDoRestaurant();
      allow create: if ativa() && podeConfigurar(ridDoNovoResource(), "pessoas");
      allow update, delete: if ativa() && podeConfigurar(ridDoResource(), "pessoas");
    }

    match /empregados/{id} {
      allow read: if leDoRestaurant();
      allow create: if ativa() && podeConfigurar(ridDoNovoResource(), "pessoas");
      allow update, delete: if ativa() && podeConfigurar(ridDoResource(), "pessoas");
    }

    match /permissionTemplates/{id} {
      allow read: if leDoRestaurant();
      allow create: if ativa() && podeConfigurar(ridDoNovoResource(), "pessoas");
      allow update, delete: if ativa() && podeConfigurar(ridDoResource(), "pessoas");
    }

    // ────────────────────────────────────────────────────────────────────────
    //  GORJETAS + REGRA DE DIVISÃO
    // ────────────────────────────────────────────────────────────────────────

    match /gorjetas/{id} {
      allow read: if leDoRestaurant();
      allow create: if ativa() && podeConfigurar(ridDoNovoResource(), "gorjetas");
      allow update, delete: if ativa() && podeConfigurar(ridDoResource(), "gorjetas");
    }

    // Regra de divisão exige permissão ESPECIAL — mexer na regra impacta
    // toda a divisão histórica via versionamento.
    match /splitVersions/{id} {
      allow read: if leDoRestaurant();
      allow create: if ativa() && permEspecial(ridDoNovoResource(), "gorjetasConfigurarRegra");
      allow update, delete: if ativa() && permEspecial(ridDoResource(), "gorjetasConfigurarRegra");
    }

    // ────────────────────────────────────────────────────────────────────────
    //  ESCALA + VT
    // ────────────────────────────────────────────────────────────────────────

    match /escalas/{id} {
      allow read: if leDoRestaurant();
      allow create: if ativa() && podeConfigurar(ridDoNovoResource(), "escala");
      // Update: configurar escala. Se o doc atual está fechado (`fechadoEm`
      // setado), exige `escalaReabrir` — proteção pra reabrir mês fechado.
      allow update: if ativa() && podeConfigurar(ridDoResource(), "escala") && (
        resource.data.fechadoEm == null ||
        resource.data.fechadoEm == "" ||
        permEspecial(ridDoResource(), "escalaReabrir")
      );
      allow delete: if ativa() && podeConfigurar(ridDoResource(), "escala");
    }

    match /vtFolhas/{id} {
      allow read: if leDoRestaurant();
      allow create: if ativa() && podeConfigurar(ridDoNovoResource(), "vt");
      allow update, delete: if ativa() && podeConfigurar(ridDoResource(), "vt");
    }

    // ────────────────────────────────────────────────────────────────────────
    //  COMUNICADOS
    // ────────────────────────────────────────────────────────────────────────

    match /comunicados/{id} {
      allow read: if leDoRestaurant();
      allow create: if ativa() && podeConfigurar(ridDoNovoResource(), "comunicados");
      allow update, delete: if ativa() && podeConfigurar(ridDoResource(), "comunicados");
    }

    // Leituras: cada pessoa marca a sua. ID = `${comunicadoId}_${pessoaId}`.
    match /comunicadosLeituras/{id} {
      allow read: if leDoRestaurant();
      // Só pode criar leitura DA PRÓPRIA pessoa.
      allow create: if ativa() &&
        request.resource.data.pessoaId == request.auth.uid &&
        temAcesso(ridDoNovoResource());
      // Não permite editar leitura — uma vez registrada, é histórico.
      allow update: if false;
      allow delete: if isMaster() ||
        (ativa() && resource.data.pessoaId == request.auth.uid);
    }

    // ────────────────────────────────────────────────────────────────────────
    //  TIME (ideias / reunioes / trilha)
    // ────────────────────────────────────────────────────────────────────────

    match /ideias/{id} {
      allow read: if leDoRestaurant();
      allow create: if ativa() && podeConfigurar(ridDoNovoResource(), "ideias");
      // Reunião pode atualizar status da ideia (em_pauta/discutida).
      allow update: if ativa() && (
        podeConfigurar(ridDoResource(), "ideias") ||
        podeConfigurar(ridDoResource(), "reunioes")
      );
      allow delete: if ativa() && podeConfigurar(ridDoResource(), "ideias");
    }

    match /reunioes/{id} {
      allow read: if leDoRestaurant();
      allow create: if ativa() && podeConfigurar(ridDoNovoResource(), "reunioes");
      allow update, delete: if ativa() && podeConfigurar(ridDoResource(), "reunioes");
    }

    match /eventosTrilha/{id} {
      allow read: if leDoRestaurant();
      // Auto-eventos vêm de Pessoas (admissão/demissão/cargo) e Reuniões
      // (action → trilha). Permite criar via trilha, pessoas ou reunioes.
      allow create: if ativa() && (
        podeConfigurar(ridDoNovoResource(), "trilha") ||
        podeConfigurar(ridDoNovoResource(), "pessoas") ||
        podeConfigurar(ridDoNovoResource(), "reunioes")
      );
      allow update, delete: if ativa() && podeConfigurar(ridDoResource(), "trilha");
    }

    // ────────────────────────────────────────────────────────────────────────
    //  OPERAÇÃO (ocorrencias / checklists / reservas / contagens / compras)
    // ────────────────────────────────────────────────────────────────────────

    match /ocorrencias/{id} {
      allow read: if leDoRestaurant();
      allow create: if ativa() && podeConfigurar(ridDoNovoResource(), "ocorrencias");
      allow update, delete: if ativa() && podeConfigurar(ridDoResource(), "ocorrencias");
    }

    match /checklistTemplates/{id} {
      allow read: if leDoRestaurant();
      allow create: if ativa() && podeConfigurar(ridDoNovoResource(), "checklists");
      allow update, delete: if ativa() && podeConfigurar(ridDoResource(), "checklists");
    }

    match /checklistRuns/{id} {
      allow read: if leDoRestaurant();
      allow create: if ativa() && podeConfigurar(ridDoNovoResource(), "checklists");
      allow update, delete: if ativa() && podeConfigurar(ridDoResource(), "checklists");
    }

    match /clientes/{id} {
      allow read: if leDoRestaurant();
      allow create: if ativa() && podeConfigurar(ridDoNovoResource(), "reservas");
      allow update, delete: if ativa() && podeConfigurar(ridDoResource(), "reservas");
    }

    match /mesas/{id} {
      allow read: if leDoRestaurant();
      allow create: if ativa() && podeConfigurar(ridDoNovoResource(), "reservas");
      allow update, delete: if ativa() && podeConfigurar(ridDoResource(), "reservas");
    }

    match /reservas/{id} {
      allow read: if leDoRestaurant();
      allow create: if ativa() && podeConfigurar(ridDoNovoResource(), "reservas");
      allow update, delete: if ativa() && podeConfigurar(ridDoResource(), "reservas");
    }

    match /insumos/{id} {
      allow read: if leDoRestaurant();
      allow create: if ativa() && podeConfigurar(ridDoNovoResource(), "contagens");
      allow update, delete: if ativa() && podeConfigurar(ridDoResource(), "contagens");
    }

    match /contagens/{id} {
      allow read: if leDoRestaurant();
      allow create: if ativa() && podeConfigurar(ridDoNovoResource(), "contagens");
      allow update, delete: if ativa() && podeConfigurar(ridDoResource(), "contagens");
    }

    match /fornecedores/{id} {
      allow read: if leDoRestaurant();
      allow create: if ativa() && podeConfigurar(ridDoNovoResource(), "compras");
      allow update, delete: if ativa() && podeConfigurar(ridDoResource(), "compras");
    }

    match /pedidos/{id} {
      allow read: if leDoRestaurant();
      allow create: if ativa() && podeConfigurar(ridDoNovoResource(), "compras");
      allow update, delete: if ativa() && podeConfigurar(ridDoResource(), "compras");
    }

    // ────────────────────────────────────────────────────────────────────────
    //  AUDITORIA / HISTÓRICO / MUDANÇAS AGENDADAS
    // ────────────────────────────────────────────────────────────────────────

    match /auditLog/{id} {
      // Read: pessoa precisa ter acesso ao restaurante do log (se houver).
      allow read: if ativa() && (
        isMaster() ||
        resource.data.restaurantId == null ||
        temAcesso(resource.data.restaurantId)
      );
      // Create: qualquer pessoa ativa (registradoPor já é o uid dela).
      allow create: if ativa() &&
        request.resource.data.registradoPor == request.auth.uid;
      // Logs são imutáveis depois de criados.
      allow update, delete: if isMaster();
    }

    match /historicos/{id} {
      // Versionamento de campos. Read amplo, write por pessoa ativa.
      allow read: if ativa();
      allow create, update: if ativa();
      allow delete: if isMaster();
    }

    match /mudancasAgendadas/{id} {
      allow read: if ativa();
      allow create: if ativa() &&
        request.resource.data.registradoPor == request.auth.uid;
      allow update: if ativa();  // pendingChangesJob marca aplicadoEm
      allow delete: if isMaster();
    }

    // ────────────────────────────────────────────────────────────────────────
    //  Default deny — qualquer collection não declarada acima é negada.
    // ────────────────────────────────────────────────────────────────────────
  }
}
