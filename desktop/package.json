{
  "name": "planejamento-pdv-desktop",
  "productName": "Planejamento PDV",
  "version": "1.0.6",
  "description": "App de caixa (PDV) do planejamento.app — abre o Comandas e imprime direto na Epson por IP (ESC/POS).",
  "main": "main.js",
  "author": "planejamento.app",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "node-thermal-printer": "^4.4.4"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.planejamento.pdv",
    "productName": "Planejamento PDV",
    "files": [
      "main.js",
      "preload.js",
      "print.js",
      "config.json"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.business"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://comandas.planejamento.app/pdv-update",
        "channel": "latest"
      }
    ]
  }
}
