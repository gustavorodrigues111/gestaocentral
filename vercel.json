{
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "lobozo.com.br" }],
      "destination": "/site/lobozo/"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.lobozo.com.br" }],
      "destination": "/site/lobozo/"
    },
    { "source": "/copa", "destination": "/copa.html" },
    { "source": "/((?!api/|site/|copa).*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/tarefas-gerar",
      "schedule": "0 9 * * *"
    }
  ]
}
