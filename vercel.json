{
  "functions": {
    "api/cardapio-pdf.py": { "includeFiles": "api/_cardapio_assets/**" },
    "api/cardapio-site-pdf.ts": { "memory": 1024, "maxDuration": 90 },
    "api/orcamento-pdf.ts": { "memory": 1024, "maxDuration": 90 },
    "api/contrato-pdf.ts": { "memory": 1024, "maxDuration": 90 },
    "api/getin-sync.ts": { "memory": 1024, "maxDuration": 120 }
  },
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "lobozo.com.br" }],
      "destination": "/site/lobozo/"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.lobozo.com.br" }],
      "destination": "/site/lobozo/"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "sororoca.com.br" }],
      "destination": "/site/sororoca/"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.sororoca.com.br" }],
      "destination": "/site/sororoca/"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "sororocabar.com.br" }],
      "destination": "/site/sororoca/"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.sororocabar.com.br" }],
      "destination": "/site/sororoca/"
    },
    { "source": "/copa", "destination": "/copa.html" },
    { "source": "/((?!api/|site/|copa).*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/tarefas-gerar",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/rotinas-notificar",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/evolution-healthcheck",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/getin-sync",
      "schedule": "*/15 * * * *"
    }
  ]
}
